<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer": signs AudioLinker-Setup-<version>.exe,
  the second signing request of a release (the installer is built with the
  already signed AudioLinker.exe inside). Paste it into the SignPath project
  (slug "installer"). The uninstaller Inno Setup generates at install time is
  not signed by this request.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="AudioLinker-Setup-${version}.exe" product-name="AudioLinker" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
