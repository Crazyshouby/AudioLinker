#include "resource.h"
#include "version.h"
#include <winver.h>

IDI_APPICON ICON "AudioLinker.ico"
// The pages are embedded from their build-time generated, self-contained
// versions (common.css/common.js inlined -- see cmake/InlineAssets.cmake),
// found through the include path that CMake points at the gen/ directory.
IDR_UI_HTML RCDATA "ui.gen.html"
IDR_OPTIONS_HTML RCDATA "options.gen.html"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AL_VERSION_RC
 PRODUCTVERSION AL_VERSION_RC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040C = French (France), 04B0 = Unicode.
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "Valentin"
            VALUE "FileDescription", "AudioLinker - Groupe d'enceintes multi-sorties"
            VALUE "FileVersion", AL_VERSION_STR
            VALUE "InternalName", "AudioLinker"
            VALUE "OriginalFilename", "AudioLinker.exe"
            VALUE "ProductName", "AudioLinker"
            VALUE "ProductVersion", AL_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x40C, 1200
    END
END
